# Backend (FastAPI) — read from backend/.env, prefix SD_
SD_DEBUG=true
SD_COOKIE_SECURE=false
# Feed recommender: baseline-v0 (default) or seen-least-v1 (adds "Outside your usual")
SD_ACTIVE_ALGORITHM=baseline-v0
# SD_DATABASE_URL=sqlite:////absolute/path/to/serendipity.db
# SD_SEED_PASSWORD=serendipity-demo
# SD_ADMIN_PASSWORD=serendipity-admin

# Frontend (Next.js) — read from frontend/.env.local
API_ORIGIN=http://localhost:8000
